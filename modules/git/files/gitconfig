[init]
    defaultBranch = main
[pull]
    ff = only
[fetch]
    prune = true
[push]
    autoSetupRemote = true
[core]
    excludesFile = ~/.config/sandlight-dotfiles/gitignore
[alias]
    branches = branch --sort=-committerdate
    last = log -1 --stat
    graph = log --graph --decorate --oneline --all
    unstage = restore --staged

